{
  "name": "jub-web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:dev": "run-p type-check && vite build --mode dev",
    "build:prod": "run-p type-check && vite build --mode prod",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.7",
    "@hintay/vue-video-background": "^3.0.7",
    "@mdi/font": "7.4.47",
    "@number-flow/vue": "^0.5.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.21",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.1",
    "vue3-autocounter": "^1.0.8",
    "vuetify": "^3.10.1"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.3",
    "eslint-config-vuetify": "^3.0.3",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.9.2",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.2.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-layouts-next": "^1.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.0"
  }
}
